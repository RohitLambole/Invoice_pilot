# InvoicePilot Environment Configuration
# Copy this file to .env and fill in your sandbox credentials.
# NEVER commit .env to version control.

# PayPal Sandbox Credentials
# Get these from: https://developer.paypal.com/dashboard/ -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_SECRET=your_sandbox_secret_here
# Note: PAYPAL_CLIENT_SECRET is accepted as an alias for PAYPAL_SECRET

# Google Gemini API
# Get this from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model (recommended: gemini-2.5-flash)
# Change this to swap models in one line
GEMINI_MODEL=gemini-2.5-flash
